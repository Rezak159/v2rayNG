# Шаблон внешних ссылок A4VPN.
# Скопируй в V2rayNG/a4.properties (файл в .gitignore) и впиши свои значения.
# В CI вместо файла можно выставить переменные окружения
# A4_TELEGRAM_BOT_URL и A4_SITE_URL.

# Telegram-бот, который выдаёт ключ доступа.
a4.telegramBotUrl=https://t.me/<bot>

# Сайт с инструкцией на случай, если Telegram не открывается.
a4.siteUrl=https://<site>/

# DSN проекта в нашем GlitchTip. Необязателен: без него диагностика выключена,
# сборка проходит. В CI — переменная окружения A4_GLITCHTIP_DSN.
a4.glitchtipDsn=https://<key>@<glitchtip-host>/<project-id>
